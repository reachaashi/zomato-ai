# Hugging Face dataset (https://huggingface.co/datasets/ManikaSaini/zomato-restaurant-recommendation)
HF_DATASET_NAME=ManikaSaini/zomato-restaurant-recommendation

# LLM provider (openai-compatible API; swap implementation via LLM_PROVIDER)
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile


# Pipeline limits
MAX_CANDIDATES=30
DEFAULT_TOP_K=5

# Optional local Parquet cache (directory created on first ingest)
DATA_CACHE_PATH=data/cache.parquet
